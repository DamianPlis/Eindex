# Next.js frontend (from the selected Convex deployment)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Local development selection, normally written by convex dev
# CONVEX_DEPLOYMENT=dev:your-deployment

# Hosting build only: matching Convex production or preview deploy key
# CONVEX_DEPLOY_KEY=

# Set these on the Convex deployment, not in browser variables:
# SITE_URL=https://your-app.example
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# JWT_PRIVATE_KEY=
# JWKS=
# CONVEX_SITE_URL is supplied automatically by Convex.

# Offline legacy import/parity scripts only (not needed by the app):
# FIREBASE_ADMIN_CREDENTIALS={"type":"service_account",...}
# Or FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
